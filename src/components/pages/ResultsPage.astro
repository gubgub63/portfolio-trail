---
import TrailLayout from '../../layouts/TrailLayout.astro';
import PageHeader from '../trail/PageHeader.astro';
import ResultHighlights from '../trail/ResultHighlights.astro';
import ResultsHistory from '../trail/ResultsHistory.astro';
import { siteCopy } from '../../data/site-copy';
import type { Lang } from '../../lib/routes';

const { lang } = Astro.props as { lang: Lang };
const t = siteCopy[lang];
---

<TrailLayout lang={lang} title={t.results.title} description={t.results.description} page="results">
    <PageHeader kicker={t.results.kicker} heading={t.results.heading} intro={t.home.resultsIntro} />
    <section class="trail-wrap results-section" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading" class="results-subtitle">
            {t.results.highlights}
        </h2>
        <ResultHighlights lang={lang} />
    </section>
    <section class="trail-wrap results-section" aria-label={t.results.history}>
        <ResultsHistory lang={lang} />
    </section>
</TrailLayout>
