---
interface Props {
    heading: readonly [string, string];
    intro?: string;
    id?: string;
}
const { heading, intro, id = 'page-title' } = Astro.props;
---

<header class="page-header trail-wrap">
    <div class="page-header-grid">
        <h1 id={id}>
            {heading[0]}
            <br />
            <span>{heading[1]}</span>
        </h1>
        {(intro || Astro.slots.has('default')) && (
            <div class="page-header-aside">
                {intro && <p class="trail-lead">{intro}</p>}
                <slot />
            </div>
        )}
    </div>
</header>
